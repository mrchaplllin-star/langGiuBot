{
  "name": "langgiubot",
  "version": "0.1.0",
  "description": "Production-ready Telegram bot starter for an Italian learning assistant.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "telegram",
    "telegraf",
    "typescript",
    "starter"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.6.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
